# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
server-3100.log

# Blender asset-proof caches (regenerated by tools/blender/golden-path-proof)
/tools/blender/golden-path-proof/cache/
/tools/blender/golden-path-proof/__pycache__/
/tools/blender/golden-path-proof/cache_*/
/tools/blender/golden-path-proof/cache_*.log
*.blend1

# Raw capture recordings: regenerated by e2e/golden-path-capture.mjs
/review-vfx/golden-path-integration/raw/

# Review frames: 26MB of PNG regenerated by e2e/golden-path-sheet.mjs. The
# contact sheets built from them are what the review reads, and those are
# committed.
/review-vfx/golden-path-integration/frames/

# Review build: the golden path's held-clock bundle, never shipped
/.next-review/
